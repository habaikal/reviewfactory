FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
RUN apt-get update && apt-get install -y python3.11 python3.11-venv python3-pip nodejs npm ffmpeg curl git wget supervisor && rm -rf /var/lib/apt/lists/*
RUN python3.11 -m pip install --upgrade pip
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI && cd /app/ComfyUI && pip install -r requirements.txt
COPY backend/ /app/backend/
COPY remotion/ /app/remotion/
COPY frontend/ /app/frontend/
WORKDIR /app/frontend
RUN npm install && npm run build || true
WORKDIR /app
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
EXPOSE 8000 8188 3000 3001 8001
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
